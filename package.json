{
  "name": "librarium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "npm run -s assets && vite",
    "build": "npm run build:worker:release && tauri build --config src-tauri/tauri.bundle.json",
    "build:web": "npm run -s assets && npm run typecheck && vite build",
    "build:worker": "cargo build -q -p librarium-worker",
    "build:worker:release": "cargo build --release -p librarium-worker && node scripts/stage-worker.mjs",
    "gen:types": "cargo run -q -p librarium-contracts --example gen_types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "npm run test:web && npm run test:webkit && npm run test:rust",
    "test:web": "vitest run --exclude tests/perf.test.ts --exclude tests/shell.test.ts && vitest run tests/perf.test.ts tests/shell.test.ts --no-file-parallelism",
    "test:rust": "cargo test --workspace",
    "arch-report": "vitest run tests/arch.test.ts && cargo test -q -p librarium-app --test arch_report -- --nocapture",
    "lint": "npm run lint:web && npm run lint:deps && npm run lint:rust",
    "lint:web": "eslint .",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings && cargo fmt --all --check",
    "tauri": "tauri",
    "dev:mock": "npm run -s assets && vite --mode mock",
    "assets": "node scripts/copy-pdfjs.mjs",
    "test:webkit": "node scripts/webkit-check.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@excalidraw/excalidraw": "0.18.1",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.7.2",
    "@readium/navigator": "2.11.1",
    "@readium/shared": "2.6.0",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-updater": "2.13.2",
    "approx-string-match": "2.0.0",
    "fflate": "0.8.3",
    "lucide": "1.50.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20",
      "sass": "1.105.1"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1"
  }
}

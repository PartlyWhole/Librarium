{
  "name": "librarium",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "npm run -s assets && vite",
    "build": "tauri build",
    "build:web": "npm run -s assets && npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "cd src-tauri && cargo test && cd .. && vitest run --passWithNoTests",
    "assets": "node scripts/assets.mjs",
    "release": "node scripts/release.mjs"
  },

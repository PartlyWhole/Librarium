{
  "name": "librarium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "npm run build:worker:release && tauri build --config src-tauri/tauri.bundle.json",
    "build:web": "npm run typecheck && vite build",
    "build:worker": "cargo build -q -p librarium-worker",
    "build:worker:release": "cargo build --release -p librarium-worker && node scripts/stage-worker.mjs",
    "gen:types": "cargo run -q -p librarium-contracts --example gen_types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "npm run test:web && npm run test:rust",
    "test:web": "vitest run",
    "test:rust": "cargo test --workspace",
    "arch-report": "cargo test -q -p librarium-app --test arch_report -- --nocapture",
    "lint": "npm run lint:web && npm run lint:deps && npm run lint:rust",
    "lint:web": "eslint .",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings && cargo fmt --all --check",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "24.19.1",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}

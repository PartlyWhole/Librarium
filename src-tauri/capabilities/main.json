{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: the only webview with IPC. Webviews showing captured pages or EPUBs get none.",
  "windows": ["main"],
  "permissions": ["core:default", "core:menu:default", "core:window:allow-destroy", "dialog:allow-open", "dialog:allow-save", "allow-rpc", "allow-subscribe", "allow-bytes", "updater:default", "allow-restart", "allow-quit"]
}
